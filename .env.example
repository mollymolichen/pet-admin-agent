# GitHub Copilot API Gateway settings
GITHUB_COPILOT_API_GATEWAY_BASE_URL=http://127.0.0.1:3030/v1
GITHUB_COPILOT_API_GATEWAY_API_KEY=optional

# Model to use through the gateway. Use a value from the gateway's model list, e.g. gpt-5 or claude-sonnet-5.
DEEPAGENT_MODEL=gpt-5

# Optional compatibility values for other providers
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=your-openai-api-key
GOOGLE_API_KEY=your-google-api-key
